{
  "name": "pumpoff",
  "version": "0.1.0",
  "private": true,
  "description": "PumpOff: live 1v1 exercise battles with rep counting, leaderboards and ranking.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm --workspaces --if-present test",
    "dev": "npm --workspace @pumpoff/web run dev",
    "dev:phone": "npm --workspace @pumpoff/web run dev:phone",
    "build": "npm --workspace @pumpoff/web run build"
  }
}
